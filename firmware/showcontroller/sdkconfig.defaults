# Project defaults for the Waveshare ESP32-C6-Touch-AMOLED-1.8 (SKU 33305).
#
# Regenerate sdkconfig after editing this file:  rm sdkconfig && idf.py build
# Anything set here can still be overridden per-developer with `idf.py menuconfig`
# (that writes sdkconfig, which wins over these defaults).

# --- Flash / partitions -------------------------------------------------------
# The board carries 16 MB of flash and no PSRAM (see firmware/README.md).
# The default 2 MB / 1 MB-factory layout cannot hold LVGL + Wi-Fi + mDNS, and
# even IDF's "single app, large" (1.5 MB) leaves under 3 kB free -- so this
# project ships its own partitions.csv with a 4 MB factory app.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- LVGL ---------------------------------------------------------------------
# showui.c uses these Montserrat sizes; LVGL only compiles in the ones enabled
# here, so every size referenced by the shared UI must be listed.
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# esp_lvgl_port's LVGL tick/timer task wants a 1 kHz scheduler tick for smooth
# animation and responsive touch; the IDF default of 100 Hz makes both coarse.
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth (NimBLE) -- StageWand<->StageWizard BLE fallback link ----------
# main/ble_link.c: a single-connection GATT peripheral that advertises ONLY
# while Wi-Fi is down (docs/showlink.md's BLE section -- Espressif marks
# Wi-Fi-connected + BLE-connected coexistence "performance unstable", so this
# is a switchover, never simultaneous). No pairing/bonding in the shipped
# contract ("no bonding v1" -- StageWizard's BLEWandLink.swift, dev D28,
# connects without it), so the settings below drop everything this firmware
# doesn't use -- NimBLE over Bluedroid (BLE-only, smaller), Central/Observer
# roles, Security Manager, bond persistence -- and trim the mbuf pools that
# remain to a single link's actual traffic. Memory is tight here: this board
# has ~44 KB free heap before BLE (see main.c's diag_log_timer_cb log line),
# against an estimated 40-80 KB NimBLE footprint per docs/showlink.md -- watch
# that same heap log after first BLE bring-up and loosen the MSYS counts
# below if BLE_HS_ENOMEM/ENOMEM shows up.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# StageWand only ever accepts a connection (from StageWizard); it never
# scans or initiates one itself, so Central/Observer are pure overhead here.
# Dropping Central also compiles out GATT Client support, since
# CONFIG_BT_NIMBLE_GATT_CLIENT depends on CONFIG_BT_NIMBLE_ROLE_CENTRAL.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# Exactly one StageWizard central at a time. The Kconfig help text for this
# option notes each connection costs ~1 KB DRAM on ESP32-C6/C2/H2.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# StageWizard negotiates ~185 (docs/showlink.md); 256 gives NimBLE's opening
# offer some headroom without reaching for the 512-byte ATT/GATT spec max.
# ble_link.c still reads back whatever MTU is actually negotiated via
# ble_att_mtu() before handing showlink its max_chunk.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# No pairing/bonding is ever attempted in this contract, so disable the
# Security Manager outright (rather than leaving it enabled-but-idle) and
# turn off bond persistence -- both save NimBLE host RAM/flash.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# MSYS is NimBLE's system-level mbuf pool; its Kconfig help says MSYS_1 backs
# "prepare write & prepare responses" plus general ATT/GATT payload buffers.
# showlink's own framing keeps every RX write within one chunk no larger
# than (negotiated MTU - 3), so ATT Prepare Write is never exercised, and
# MAX_CONNECTIONS=1 above means there's no concurrent-peer pressure on
# either pool. Cut back from the ESP32-C6 defaults (24 blocks each) to a
# count sized for one link's ping/heartbeat/GO/cue-list-burst traffic with
# a few frames of headroom, not a multi-connection server's.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
