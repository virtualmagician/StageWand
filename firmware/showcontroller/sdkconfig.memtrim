# StageWand memory trim — measured on StageWand-FB9C (V2): only ~44 KB heap
# was free after init with the stock values, and NimBLE needs ~40-80 KB.
#
# LVGL allocates from the ESP heap instead of a fixed 64 KB builtin pool:
# frees the unused part of that reservation AND removes a hard ceiling that a
# 64-cue list (~45 KB of widgets) would otherwise hit.
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=y
# Partial draw buffer 100 -> 60 lines (73.6 KB -> 44.2 KB). Same bytes over
# QSPI per full-screen redraw, just in more transactions.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=60
# Wi-Fi buffers: OSC traffic is tiny; trim static RX (1.7 KB each) and caps.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_BA_WIN=4
